# ---------------------------------------------------------------------------
# RouteFlow - variaveis de ambiente
# Todas sao OPCIONAIS: sem nenhuma delas o projeto usa os servicos publicos
# gratuitos (Nominatim + OSRM/FOSSGIS). Nenhuma chave de API e obrigatoria.
# Copie este arquivo para .env.local e ajuste o que precisar.
# ---------------------------------------------------------------------------

# Identificacao enviada no header User-Agent das requisicoes ao Nominatim.
# A politica de uso do Nominatim EXIGE um contato valido em producao.
NOMINATIM_APP_NAME="RouteFlow"
NOMINATIM_CONTACT_EMAIL="seu-email@exemplo.com"

# Endpoint do geocoder (Nominatim ou instancia compativel/self-hosted).
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# Endpoints OSRM por perfil (instancias publicas da FOSSGIS).
# Troque por uma instancia propria para uso intensivo.
OSRM_CAR_URL="https://routing.openstreetmap.de/routed-car"
OSRM_BIKE_URL="https://routing.openstreetmap.de/routed-bike"
OSRM_FOOT_URL="https://routing.openstreetmap.de/routed-foot"

# Idioma preferencial retornado pelo geocoder.
GEOCODING_LANGUAGE="pt-BR"

# Provedores ativos (permitem trocar a implementacao sem alterar a UI).
GEOCODING_PROVIDER="nominatim"
ROUTING_PROVIDER="osrm"
